<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ThunderstoreName>DrakesPortals</ThunderstoreName>
    <ThunderstoreAuthor>DrakeMods</ThunderstoreAuthor>
    <RootNamespace>DrakesPortals</RootNamespace>
    <AssemblyName>DrakesPortals</AssemblyName>
    <Version>0.1.0</Version>
    <BepInPluginName>DrakesPortals</BepInPluginName>
    <BepInGuid>com.drakemods.portals</BepInGuid>
    <ModInfoClass>DrakesPortals</ModInfoClass>
    <Description>One-way gates for servers: each portal sends players somewhere and never back. Fixed destinations first; item, team and puzzle destinations later.</Description>
    <WebsiteUrl>https://github.com/drakethos/DrakesPortals</WebsiteUrl>
  </PropertyGroup>
  <ItemGroup>
    <ThunderstoreDependency Include="denikson-BepInExPack_Valheim-5.4.2350" />
    <ThunderstoreDependency Include="ValheimModding-Jotunn-2.30.0" />
    <ThunderstoreDependency Include="DrakeMods-DrakeModsLibs-1.0.6" />
  </ItemGroup>
</Project>
