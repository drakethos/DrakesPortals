{
  "name": "PT-10 The direction survives a relog",
  "description": "",
  "steps": [
    {
      "do": "spawn",
      "prefab": "portal_wood",
      "dx": 3,
      "dz": 3,
      "as": "a"
    },
    {
      "do": "spawn",
      "prefab": "portal_wood",
      "dx": -3,
      "dz": 3,
      "as": "b"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "portals.setTag",
      "args": {
        "tag": "pair",
        "target": "a"
      }
    },
    {
      "do": "hook",
      "name": "portals.setTag",
      "args": {
        "tag": "pair",
        "target": "b"
      }
    },
    {
      "do": "wait",
      "seconds": 5
    },
    {
      "do": "hook",
      "name": "portals.linked",
      "args": {
        "target": "a"
      },
      "expect": true,
      "label": "portal A is linked"
    },
    {
      "do": "hook",
      "name": "portals.linked",
      "args": {
        "target": "b"
      },
      "expect": true,
      "label": "portal B is linked",
      "stop": true
    },
    {
      "do": "hook",
      "name": "portals.setDirection",
      "args": {
        "direction": "Entry",
        "target": "a"
      },
      "expect": true,
      "label": "ask the server: Entry"
    },
    {
      "do": "wait",
      "seconds": 1.5
    },
    {
      "do": "relog",
      "timeout": 120
    },
    {
      "do": "wait",
      "seconds": 3
    },
    {
      "do": "hook",
      "name": "portals.direction",
      "args": {
        "target": "a"
      },
      "expect": "Entry",
      "label": "A is still the entry"
    },
    {
      "do": "hook",
      "name": "portals.direction",
      "args": {
        "target": "b"
      },
      "expect": "Exit",
      "label": "B is still the exit"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesPortals"
    }
  ]
}