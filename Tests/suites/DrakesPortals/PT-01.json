{
  "name": "PT-01 A new portal is a normal two-way portal",
  "description": "",
  "steps": [
    {
      "do": "spawn",
      "prefab": "portal_wood",
      "dx": 3,
      "dz": 3,
      "as": "a"
    },
    {
      "do": "spawn",
      "prefab": "portal_wood",
      "dx": -3,
      "dz": 3,
      "as": "b"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "portals.setTag",
      "args": {
        "tag": "pair",
        "target": "a"
      }
    },
    {
      "do": "hook",
      "name": "portals.setTag",
      "args": {
        "tag": "pair",
        "target": "b"
      }
    },
    {
      "do": "wait",
      "seconds": 5
    },
    {
      "do": "hook",
      "name": "portals.linked",
      "args": {
        "target": "a"
      },
      "expect": true,
      "label": "portal A is linked"
    },
    {
      "do": "hook",
      "name": "portals.linked",
      "args": {
        "target": "b"
      },
      "expect": true,
      "label": "portal B is linked",
      "stop": true
    },
    {
      "do": "hook",
      "name": "portals.direction",
      "args": {
        "target": "a"
      },
      "expect": "TwoWay",
      "label": "A is two-way"
    },
    {
      "do": "hook",
      "name": "portals.direction",
      "args": {
        "target": "b"
      },
      "expect": "TwoWay",
      "label": "B is two-way"
    },
    {
      "do": "hook",
      "name": "portals.blocked",
      "args": {
        "target": "a"
      },
      "expect": false,
      "label": "stepping into A is allowed"
    },
    {
      "do": "hook",
      "name": "portals.blocked",
      "args": {
        "target": "b"
      },
      "expect": false,
      "label": "stepping into B is allowed"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesPortals"
    }
  ]
}