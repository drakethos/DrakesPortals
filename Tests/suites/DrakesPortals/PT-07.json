{
  "name": "PT-07 Shift+E opens the direction menu and a click sets the direction",
  "description": "",
  "steps": [
    {
      "do": "spawn",
      "prefab": "portal_wood",
      "dx": 3,
      "dz": 3,
      "as": "a"
    },
    {
      "do": "spawn",
      "prefab": "portal_wood",
      "dx": -3,
      "dz": 3,
      "as": "b"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "portals.setTag",
      "args": {
        "tag": "pair",
        "target": "a"
      }
    },
    {
      "do": "hook",
      "name": "portals.setTag",
      "args": {
        "tag": "pair",
        "target": "b"
      }
    },
    {
      "do": "wait",
      "seconds": 5
    },
    {
      "do": "hook",
      "name": "portals.linked",
      "args": {
        "target": "a"
      },
      "expect": true,
      "label": "portal A is linked"
    },
    {
      "do": "hook",
      "name": "portals.linked",
      "args": {
        "target": "b"
      },
      "expect": true,
      "label": "portal B is linked",
      "stop": true
    },
    {
      "do": "face",
      "target": "a"
    },
    {
      "do": "interact",
      "target": "a",
      "alt": true
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "check",
      "check": "uiVisible",
      "name": "Portal direction",
      "expect": true,
      "label": "the menu opened"
    },
    {
      "do": "check",
      "check": "uiVisible",
      "name": "One-way: this is the Entry",
      "exact": true,
      "expect": true,
      "label": "Entry is offered"
    },
    {
      "do": "check",
      "check": "uiVisible",
      "name": "Two-way (normal portal)",
      "exact": true,
      "expect": false,
      "label": "the current state is not offered"
    },
    {
      "do": "click",
      "button": "One-way: this is the Entry"
    },
    {
      "do": "wait",
      "seconds": 1.5
    },
    {
      "do": "hook",
      "name": "portals.direction",
      "args": {
        "target": "a"
      },
      "expect": "Entry",
      "label": "A is the entry"
    },
    {
      "do": "hook",
      "name": "portals.direction",
      "args": {
        "target": "b"
      },
      "expect": "Exit",
      "label": "B is the exit"
    },
    {
      "do": "closeUi"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesPortals"
    }
  ]
}