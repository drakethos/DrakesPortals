{
  "name": "PT-02 One-way needs a linked pair",
  "description": "",
  "steps": [
    {
      "do": "spawn",
      "prefab": "portal_wood",
      "dx": 3,
      "dz": 3,
      "as": "solo"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "portals.setTag",
      "args": {
        "tag": "lonely",
        "target": "solo"
      }
    },
    {
      "do": "wait",
      "seconds": 2
    },
    {
      "do": "hook",
      "name": "portals.linked",
      "args": {
        "target": "solo"
      },
      "expect": false,
      "label": "nothing to link to"
    },
    {
      "do": "hook",
      "name": "portals.offered",
      "args": {
        "direction": "Entry",
        "target": "solo"
      },
      "expect": false,
      "label": "Entry is not offered"
    },
    {
      "do": "hook",
      "name": "portals.offered",
      "args": {
        "direction": "Exit",
        "target": "solo"
      },
      "expect": false,
      "label": "Exit is not offered"
    },
    {
      "do": "hook",
      "name": "portals.setDirection",
      "args": {
        "direction": "Entry",
        "target": "solo"
      },
      "expect": true,
      "label": "a request can still be sent"
    },
    {
      "do": "wait",
      "seconds": 1.5
    },
    {
      "do": "hook",
      "name": "portals.direction",
      "args": {
        "target": "solo"
      },
      "expect": "TwoWay",
      "label": "but the server refuses it"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesPortals"
    }
  ]
}